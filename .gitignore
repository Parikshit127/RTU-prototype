# ═══════════════════════════════════════════════════
# RTU Digital Platform — Git Ignore
# ═══════════════════════════════════════════════════

# ── OS Files ──
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ── IDE / Editor ──
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ── Node.js (Backend + Website) ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp.*
.yarn/

# ── Next.js (Website) ──
rtu_web/.next/
rtu_web/out/

# ── TypeScript Build Output ──
rtu_backend/dist/

# ── Flutter / Dart (Mobile App) ──
rtu_app/.dart_tool/
rtu_app/.packages
rtu_app/build/
rtu_app/.flutter-plugins
rtu_app/.flutter-plugins-dependencies
rtu_app/.pub-cache/
rtu_app/.pub/
rtu_app/pubspec.lock

# ── Environment Variables (NEVER commit these) ──
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
rtu_backend/.env
rtu_web/.env.local

# ── Generated Files ──
*.log
coverage/
.nyc_output/

# ── Python (build scripts) ──
__pycache__/
*.pyc
